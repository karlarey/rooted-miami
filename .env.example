# El Pana's brain: gemini | ollama | mock
# Defaults to gemini when GEMINI_API_KEY is set, otherwise mock.
PANA_PROVIDER=mock

# Gemini (free tier key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ollama (local, free, private: https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Auth (Better Auth). Generate a secret: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database: local SQLite by default; Turso when deployed
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Optional: real "Continue with LinkedIn" (LinkedIn developer app, OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
