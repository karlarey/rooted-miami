# El Pana's brain: gemini | ollama | mock
# Defaults to gemini when GEMINI_API_KEY is set, otherwise mock.
PANA_PROVIDER=mock

# Gemini (free tier key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ollama (local, free, private: https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Talent Finder: Gemma 4 via the Gemini API (gemma-4-31b-it errored / was slow in testing)
GEMMA_MODEL=gemma-4-26b-a4b-it
